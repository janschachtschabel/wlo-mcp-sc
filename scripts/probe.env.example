# Zugangsdaten für die Proben (session-cookie-probe.mjs, csrf-write-probe.mjs) —
# hier eintragen, dann das Skript starten. Diese Datei gehört in KEIN Repository
# und in keinen Chat: sie trägt ein Klartext-Passwort. Nach der Messung löschen.
#
# Nur nötig, wenn ein BESTIMMTES Konto gemessen werden soll — sonst nehmen die
# Skripte das Dienstkonto aus der .env im Wurzelverzeichnis.
#
# Die Skripte drucken weder Passwort noch Cookie-Werte — nur Namen, Wertlängen,
# Attribute, Statuscodes und die gemeldete authority.

WLO_USER=
WLO_PASSWORD=

# Nur ändern, wenn gegen eine andere Instanz gemessen werden soll.
WLO_REPOSITORY_URL=https://repository.staging.openeduhub.net/edu-sharing
