{
  "name": "wlomcp",
  "version": "1.0.0",
  "description": "WLO (WirLernenOnline) MCP Server – search OER content via AI agents",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.12.0",
    "npm": ">=9"
  },
  "scripts": {
    "build": "tsc && node src/apps/widgets/build.mjs",
    "build:widgets": "node src/apps/widgets/build.mjs",
    "start": "node --env-file-if-exists=.env dist/stdio.js",
    "start:http": "node --env-file-if-exists=.env dist/http.js",
    "dev": "tsx --env-file-if-exists=.env src/stdio.ts",
    "dev:http": "tsx --env-file-if-exists=.env src/http.ts",
    "test": "node scripts/run-tests.mjs",
    "test:coverage": "node scripts/run-tests.mjs --coverage",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.5",
    "typescript": "^5.4.5"
  }
}
