{
  "name": "wlo-mcp",
  "version": "1.1.0",
  "description": "WLO (WirLernenOnline) MCP Server – search OER content via AI agents",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=9"
  },
  "scripts": {
    "build": "tsc && node src/apps/widgets/build.mjs",
    "build:widgets": "node src/apps/widgets/build.mjs",
    "start": "node --env-file-if-exists=.env dist/stdio.js",
    "start:http": "node --env-file-if-exists=.env dist/http.js",
    "dev": "tsx --env-file-if-exists=.env src/stdio.ts",
    "dev:http": "tsx --env-file-if-exists=.env src/http.ts",
    "test": "node scripts/run-tests.mjs",
    "test:coverage": "node scripts/run-tests.mjs --coverage",
    "test:live": "node scripts/run-live-tests.mjs",
    "smoke:image": "bash scripts/smoke-image.sh",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "lint": "eslint .",
    "sync:vocabs": "node --import tsx --env-file-if-exists=.env scripts/sync-vocabs.mjs",
    "survey:metadata": "node --import tsx --env-file-if-exists=.env scripts/survey-metadata.mjs",
    "measure:resources": "node --env-file-if-exists=.env scripts/measure-resources.mjs",
    "measure:moves": "node --env-file-if-exists=.env --import tsx scripts/measure-collection-moves.ts",
    "measure:order": "node --env-file-if-exists=.env --import tsx scripts/measure-collection-order.ts",
    "measure:uploads": "node --env-file-if-exists=.env --import tsx scripts/measure-uploads.ts",
    "dump:tools": "node --import tsx scripts/dump-tools.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "globals": "^17.14.0",
    "tsx": "^4.23.15",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.72.2"
  }
}
